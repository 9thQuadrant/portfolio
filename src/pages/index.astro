<style is:global>
  /* is:global (not Astro's default scoped style): .shine-text gets applied
     to spans created at runtime via document.createElement in the
     personalization script, which never receive Astro's scope attribute —
     a scoped rule would silently never match them. */
  .icon-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-solid);
    color: var(--text-muted);
    transition: border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  /* same gradient-ring-on-hover treatment as the cards, so the social row
     reads as part of the palette rather than a set of grey chips */
  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    background: var(--grad-gemini);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .icon-link:hover {
    border-color: transparent;
    color: var(--heading);
    box-shadow: 0 0 22px -8px rgba(155, 114, 203, 0.9);
  }

  .icon-link:hover::before {
    opacity: 1;
  }

  /* ---- Aurora --------------------------------------------------------
     Full-width band at the top of the page. Each curtain is a soft
     blurred blob in an aurora hue, drifting on its own slow loop and
     blended additively (screen) in dark mode so overlaps brighten like
     real aurora; in light mode it switches to multiply at low opacity so
     it lands as a faint pastel wash instead of blowing out to white. */
  #aurora-wrap {
    /* absolute (not fixed) so the aurora belongs to the hero and scrolls
       away with it, rather than tinting every section as you move down */
    position: absolute;
    top: -128px; /* was -160px — brought down 20% */
    left: 0;
    right: 0;
    height: min(66vh, 600px);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 1;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 28%, transparent 97%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 28%, transparent 97%);
  }

  #aurora {
    position: relative;
    width: 100%;
    height: 100%;
    /* gentle cursor parallax — the band as a whole eases opposite the pointer */
    transform: translate3d(
      calc(var(--mx, 0px) * -0.14),
      calc(var(--my, 0px) * -0.09),
      0
    );
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .aurora-band {
    position: absolute;
    top: -55%;
    height: 170%;
    border-radius: 45% 55% 62% 38%;
    /* less blur than the travel distance, otherwise the drift is invisible */
    filter: blur(46px) saturate(var(--aurora-saturate));
    mix-blend-mode: var(--aurora-blend);
    opacity: var(--aurora-opacity);
    will-change: transform;
  }
  .aurora-band--1 {
    left: -24%;
    width: 58%;
    background: radial-gradient(closest-side at 50% 45%, var(--aurora-1), transparent 100%);
    animation: aurora-1 17s ease-in-out infinite alternate;
  }
  .aurora-band--2 {
    left: 18%;
    width: 62%;
    background: radial-gradient(closest-side at 50% 55%, var(--aurora-2), transparent 100%);
    animation: aurora-2 21s ease-in-out infinite alternate;
  }
  .aurora-band--3 {
    left: 52%;
    width: 60%;
    background: radial-gradient(closest-side at 50% 42%, var(--aurora-3), transparent 100%);
    animation: aurora-3 19s ease-in-out infinite alternate;
  }

  /* big amplitude on purpose — the curtains sweep a long way and morph
     shape so the movement reads clearly through the blur */
  @keyframes aurora-1 {
    from { transform: translate3d(-28%, -8%, 0) rotate(-18deg) scale(1, 1); }
    to   { transform: translate3d(34%, 10%, 0) rotate(10deg) scale(0.82, 1.4); }
  }
  @keyframes aurora-2 {
    from { transform: translate3d(26%, 6%, 0) rotate(14deg) scale(1.1, 1.2); }
    to   { transform: translate3d(-30%, -6%, 0) rotate(-12deg) scale(0.85, 0.9); }
  }
  @keyframes aurora-3 {
    from { transform: translate3d(16%, 0, 0) rotate(-8deg) scale(1, 1); }
    to   { transform: translate3d(-34%, 12%, 0) rotate(16deg) scale(1.15, 1.35); }
  }

  /* entrance is only a `from` keyframe with no fill-mode, so the element
     always settles back to its own opacity:1 once the 1.3s is up — it can
     never get stuck hidden */
  #aurora-wrap {
    animation: aurora-enter 1.3s ease-out;
  }
  @keyframes aurora-enter {
    from { opacity: 0; transform: translateY(-40px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora-band { animation: none; }
  }

  /* ---- hero metrics ----------------------------------------------------
     Each stat gets its own small icon (lightning/wrench/clock) so the row
     reads as three distinct proof points instead of one dense mono string.
     First element of the third visual group (metrics/chips/CTAs/social):
     the 2.5rem gap up to the tagline block lives here — see the spacing
     model note above .hero-greeting. */
  .hero-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 2.5rem 0 0;
    font-weight: 400;
    color: var(--heading);
  }
  .hero-metric {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
  }
  @media (min-width: 768px) {
    .hero-metric {
      font-size: 1.125rem;
    }
  }
  .hero-metric svg {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--link);
  }
  .hero-metric-sep {
    color: var(--text-faint);
    font-weight: 400;
  }

  /* ---- hero chips ------------------------------------------------------
     Industries + availability as individual pill shapes with a small icon
     each, instead of one long dot-separated line — breaks the hero's lower
     half into distinct, scannable pieces instead of a wall of text. Tight
     margin-top ties both chip rows to the metrics row above them, so the
     whole metrics/chips/CTA/social stretch reads as one block. */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin: 0.75rem 0 0;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border-solid);
    background: var(--surface);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .hero-chip svg {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--link);
  }

  /* ---- "What I Can Help With" ------------------------------------------ */
  .help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .help-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-solid);
    background: var(--surface);
    color: var(--heading);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .help-item:hover {
    background: var(--surface-hover);
    border-color: var(--link);
    transform: translateY(-2px);
  }
  .help-item svg {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--link);
  }

  /* ---- "Selected Engineering Impact" ------------------------------------ */
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .impact-stat__number {
    font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
    background-image: var(--grad-gemini);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (min-width: 768px) {
    .impact-stat__number {
      font-size: 2rem;
    }
  }
  .impact-stat__label {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ---- "Case Studies" ---------------------------------------------------
     Same three roles as Experience, reframed as problem/decisions/
     implementation/result. Built directly from the achievement bullets in
     data/content.ts — nothing invented, just restructured. */
  .case-flow {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-bottom: 3rem;
    margin-top: -2.5rem;
  }
  .case-study-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .case-study {
    border: 1px solid var(--border-solid);
    background: var(--surface);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: var(--card-shadow);
  }
  .case-study__company {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--link);
    margin-bottom: 0.4rem;
  }
  .case-study__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--heading);
    margin-bottom: 1.4rem;
  }
  .case-study__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 800px) {
    .case-study__steps {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }
  .case-study__step-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.4rem;
  }
  .case-study__step--result .case-study__step-label {
    color: var(--link);
  }
  .case-study__step-body {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ---- closing CTA ------------------------------------------------------ */
  .closing-cta__question {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--heading);
    margin-bottom: 1.5rem;
  }

  /* Slightly more room than the chip rows get, since buttons carry more
     visual weight — still well under the 2.5rem inter-block gap, so it
     reads as the same block as the metrics/chips above and the social
     row below, not a break. */
  .hero-cta-row {
    margin-top: 1.25rem;
  }

  /* ---- secondary CTA (outline) — sits next to .shiny-cta, deliberately
     quieter: no gradient border, no glow, just a border that picks up the
     link colour on hover. */
  .btn-outline {
    border-color: var(--border-solid);
    color: var(--text-secondary);
    background: transparent;
    /* matches .shiny-cta's own entrance timing so both buttons in the
       CTA row fade up together */
    animation: fade-up 0.7s 0.5s ease-out both;
  }
  .btn-outline:hover {
    border-color: var(--link);
    color: var(--heading);
    background: var(--surface);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-outline { animation: fade-up 0.7s 0.5s ease-out both; }
  }

  /* ---- social row — smaller than the header icon row (still secondary
     to the CTAs above), but with a real fill and solid contrast so they
     don't read as barely-there ghosts. Tight margin-top: last element of
     the metrics/chips/CTA/social block. */
  .social-row {
    margin-top: 0.9rem;
  }
  .social-row .icon-link {
    width: 36px;
    height: 36px;
    background: var(--surface);
    color: var(--text-secondary);
  }
  .social-row .icon-link:hover {
    background: var(--surface-hover);
  }

  /* ---- hero identity block ------------------------------------------
     Order is: optional personalized greeting → name (never changes) →
     role/title (gradient, same treatment the old eyebrow used, just
     repositioned below the name) → static tagline.

     Spacing model, top-down: every element below carries its OWN gap from
     whatever precedes it as margin-top, and margin-bottom: 0 — never both.
     That makes each gap a single number to tune, and (thanks to margin
     collapsing) the personalized path (greeting → identity → context) and
     the default path (headline → role) both hand off to the tagline with
     the exact same gap, however much text the personalized side has.
     Three visual groups, three gap sizes:
       - within the 3-line personalized block: 0.4rem (reads as one block)
       - block → block (personalization/name, tagline, metrics+chips+CTAs):
         2.5rem (a real break)
       - within the metrics/chips/CTA/social block: 0.75–1.25rem (see
         .hero-metrics/.hero-chips/.hero-cta-row/.social-row below) */
  /* Cold-email-only greeting — "Hi {fn}, thanks for taking a look."
     Largest of the three personalized lines, close to the scale of the
     default hero's own name headline so it carries the same weight as
     the thing it's replacing. */
  .hero-greeting {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--heading);
    margin-bottom: 0;
  }
  @media (min-width: 768px) {
    .hero-greeting {
      font-size: 3.125rem;
    }
  }

  /* Cold-email-only identity line — "I'm Phaneendra Kanduri, a Senior
     Frontend Engineer at IBM." Static (see #hero-identity in the markup):
     revealed by the .is-cold-email CSS rule in Base.astro, no JS needed. */
  .hero-identity {
    max-width: 42rem;
    margin: 0.4rem auto 0;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  @media (min-width: 768px) {
    .hero-identity {
      font-size: 1.875rem;
    }
  }

  /* Cold-email-only context line — "I put this page together with {co} in
     mind." Only shown when ?co= is present; same size as the regular
     tagline since it reads as ordinary body copy, not a headline. */
  .hero-context {
    max-width: 42rem;
    margin: 0.4rem auto 0;
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.625;
    color: var(--text-muted);
  }
  @media (min-width: 768px) {
    .hero-context {
      font-size: 1.25rem;
    }
  }

  .hero-role {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    margin-bottom: 0;
    background-image: var(--grad-gemini);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 10px var(--shadow-ink))
            drop-shadow(0 0 3px var(--shadow-ink));
  }

  /* Its own block: a full 2.5rem gap above (from the name/role or the
     personalized greeting, whichever ran), and nothing tying it to the
     metrics/chips/CTA block below — that gap belongs to that block's own
     first element (.hero-metrics), for the same margin-collapsing reason.

     max-width is wider than the other hero copy (58rem, not 42rem):
     DM Mono is a monospace face, so it runs noticeably wider per
     character than the proportional body font used elsewhere — at 42rem
     the longest intro+ending combination didn't fit and wrapped even on
     a plenty-wide desktop viewport, which is the box's own cap biting,
     not the real viewport running out of room. 58rem gives it enough
     width to actually use the space that's there. */
  .hero-tagline {
    max-width: 58rem;
    margin: 2.5rem auto 0;
    font-size: 1.125rem;
    line-height: 1.625;
    color: var(--text);
  }
  @media (min-width: 768px) {
    .hero-tagline {
      font-size: 1.25rem;
    }
  }
  /* Tagline reads as one flowing line: static lead-in text, then the
     rotator immediately after it, wrapping together like normal text only
     if the viewport is genuinely too narrow for both (unavoidable on the
     smallest phones for the longer endings). */
  .hero-tagline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: 0.4em;
    row-gap: 0.2rem;
  }
  /* Static lead-in — same family as the rotating ending, but upright and
     regular weight, so the two read as one sentence in one voice while
     the swap between "written" and "spoken with emphasis" still comes
     through in weight/style rather than a font change. */
  .hero-tagline__intro {
    font-family: 'DM Mono', 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
    font-weight: 400;
    font-style: normal;
  }

  /* ---- rotating tail end of the tagline ---------------------------------
     All six endings sit stacked in the same CSS grid cell (grid-area 1/1),
     which auto-sizes the box to the widest/tallest of them — so it holds
     a stable width and height across swaps with no explicit measuring.
     Each line stays single-line (white-space: nowrap) so the odometer
     slide never re-wraps mid-transition. Line 1 ships .is-active from the
     server, which is also what prefers-reduced-motion and no-JS visitors
     see, permanently. */
  .hero-rotator {
    display: inline-grid;
    /* start, not stretch: without this every line's box stretches to the
       column's full (longest-line) width, and a shorter line then centers
       inside that extra space — opening a visible gap after the static
       lead-in text instead of butting straight up against it. */
    justify-items: start;
    max-width: 100%;
    overflow: hidden;
    vertical-align: baseline;
  }
  /* Odometer-style rotation: the active line sits at rest; the next line
     rises up from below to replace it, while the outgoing line keeps
     travelling up and out — same direction throughout, like a rolling
     counter, rather than a plain crossfade. .is-leaving is added/removed
     by the rotator script once each swap's transition finishes, so an
     outgoing line is always reset below (its rest position) before its
     next turn. */
  .hero-rotator__line {
    grid-area: 1 / 1;
    white-space: nowrap;
    text-align: left;
    font-family: 'DM Mono', 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
    font-weight: 700;
    font-style: italic;
    color: var(--heading);
    opacity: 0;
    transform: translateY(65%);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.35s ease;
    pointer-events: none;
  }
  .hero-rotator__line.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  .hero-rotator__line.is-leaving {
    opacity: 0;
    transform: translateY(-65%);
