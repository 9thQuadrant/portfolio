    </div>
  </section>

  <!-- Links -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="mono text-xs uppercase tracking-[0.3em] text-blue-400 mb-14">Around the web</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map((link) => (
          <a href={link.href} target={link.href !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="flex items-center justify-between border border-slate-800 rounded-lg px-5 py-4 hover:border-blue-500 group transition-all duration-200">
            <div>
              <p class="text-sm font-medium text-white group-hover:text-blue-400 transition-colors">{link.label}</p>
              <p class="mono text-xs text-slate-600 mt-0.5">{link.sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              class="text-slate-700 group-hover:text-blue-400 transition-colors"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative z-10 py-10 px-6 text-center border-t border-slate-900">
    <a href="mailto:phaneendra@9thquadrant.com"
      class="mono text-xs text-slate-600 hover:text-blue-400 transition-colors">
      phaneendra@9thquadrant.com
    </a>
  </footer>
</Base>

<style is:global>
  /* is:global (not Astro's default scoped style): .shine-text gets applied
     to spans created at runtime via document.createElement in the
     personalization script, which never receive Astro's scope attribute —
     a scoped rule would silently never match them. */
  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(51 65 85); /* slate-700 */
    color: rgb(148 163 184); /* slate-400 */
    transition: border-color 0.2s, color 0.2s;
  }

  .icon-link:hover {
    border-color: rgb(96 165 250); /* blue-400 */
    color: rgb(96 165 250);
  }

  #mouse-glow-wrap {
    position: fixed;
    top: -220px;
    left: 50%;
    width: 640px;
    height: 420px;
    transform: translate(-50%, 0);
    pointer-events: none;
    z-index: 1;
    opacity: 1;
  }

  #mouse-glow {
    width: 100%;
    height: 100%;
    background: conic-gradient(from 0deg, #60a5fa, #a78bfa, #22d3ee, #7c3aed, #60a5fa);
    filter: blur(100px);
    opacity: 0.45;
    /* Position follows the cursor; scale gives it a brief "swell" on
       movement, like a disturbed water surface — the elastic easing lets
       it overshoot slightly and settle rather than snapping into place. */
    transform: translate(var(--mx, 0px), var(--my, 0px)) scale(var(--s, 1));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    #mouse-glow-wrap {
      opacity: 0;
      animation: mouse-glow-enter 1s ease-out forwards;
    }

    #mouse-glow {
      animation: mouse-glow-shift 18s linear infinite;
    }
  }

  @keyframes mouse-glow-enter {
    from { opacity: 0; transform: translate(-50%, -120px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }

  @keyframes mouse-glow-shift {
    0% { filter: blur(100px) hue-rotate(0deg); }
    100% { filter: blur(100px) hue-rotate(360deg); }
  }

  /* Same idea as the ambient glow, applied to text: a gradient bigger than
     the text itself, panned by the same --mx/--my the glow uses, so both
     shift together with the cursor. Falls back to a static gradient with
     no motion if reduced-motion is set (the --mx/--my custom properties
     are simply never updated in that case). */
  .shine-text {
    /* Linear, not conic like #mouse-glow above — a conic gradient has a
       center vertex where all its color bands converge, which showed up
       as a visible seam in the text no matter how it was positioned.
       A linear gradient is just a smooth directional blend with no such
       point, so there's nothing to hide — same 4 colors, no artifact. */
    background-image: linear-gradient(115deg, #60a5fa 0%, #a78bfa 33%, #22d3ee 66%, #7c3aed 100%);
    background-size: 200% 200%;
    background-position: calc(50% + var(--mx, 0px)) calc(50% + var(--my, 0px));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
