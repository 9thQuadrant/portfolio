  }

  .scroll-cue__chevrons {
    position: relative;
    width: 32px;
    height: 24px;
    filter: drop-shadow(0 0 10px var(--cue-glow));
  }
  .scroll-cue__chevrons svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 13px;
    opacity: 0;
    animation: cue-chev 1.7s ease-in-out infinite;
  }
  .scroll-cue__chevrons svg:nth-child(2) { animation-delay: 0.2s; }
  .scroll-cue__chevrons svg:nth-child(3) { animation-delay: 0.4s; }

  @keyframes cue-chev {
    0%   { opacity: 0; transform: translateY(-6px); }
    35%  { opacity: 1; }
    70%  { opacity: 0; transform: translateY(12px); }
    100% { opacity: 0; transform: translateY(12px); }
  }
  @keyframes cue-text-pulse {
    0%, 100% { opacity: 0.6; }
    50%      { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
