---
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import { experiences, skills, links } from '../data/content';

// Rotating hero subheadline. Order is deliberate: React leads (the site is
// positioned for React/TypeScript/Next.js roles), Angular depth shows up
// third — real and detailed in Experience, just not the first thing a
// visitor reads. Line 1 doubles as the static, server-rendered fallback
// (no-JS and reduced-motion both land here) — see the .sr-only paragraph
// and the rotator script further down.
const rotatingLines = [
  'React across the full lifecycle: greenfield PWAs, legacy modernization, and framework migrations.',
  'Cut FCP from 2s to 0.2s. Cut build times from 20 minutes to 90 seconds.',
  'Led a 500-component Angular migration with a 15-engineer team, end to end.',
  'Shipped in regulated environments only: healthcare, HR tech, and enterprise SaaS.',
];
---

<Base>
  <Stars />

  <!-- Aurora: a soft band of coloured light along the top of the page.
       Three blurred curtains in aurora hues (green / cyan / violet →
       pink), each drifting on its own slow loop and blended additively so
       they mix where they overlap. A bottom mask dissolves the whole thing
       into the page. The cursor gives it a gentle parallax. -->
  <div id="aurora-wrap" aria-hidden="true">
    <div id="aurora">
      <span class="aurora-band aurora-band--1"></span>
      <span class="aurora-band aurora-band--2"></span>
      <span class="aurora-band aurora-band--3"></span>
    </div>
  </div>
  <script is:inline>
    (function () {
      var aurora = document.getElementById('aurora');
      if (!aurora) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // --mx/--my live on the root element so the aurora parallax and the
      // .shine-text gradient sweep both read the same cursor position.
      var root = document.documentElement;
      var raf = null;
      window.addEventListener(
        'mousemove',
        function (e) {
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = null;
            var dx = (e.clientX / window.innerWidth - 0.5) * 180;
            var dy = (e.clientY / window.innerHeight - 0.5) * 100;
            root.style.setProperty('--mx', dx.toFixed(1) + 'px');
            root.style.setProperty('--my', dy.toFixed(1) + 'px');
          });
        },
        { passive: true }
      );
    })();
  </script>

  <!-- Hero -->
  <section id="top" class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 pt-20 pb-28 text-center">
    <p id="hero-eyebrow" class="hero-eyebrow animate-fade-up-delay-1">
      Senior Frontend Engineer
    </p>

    <div id="hero-headline">
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-2 animate-fade-up-delay-2 text-[color:var(--heading)]">
        Phaneendra
      </h1>
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-7 animate-fade-up-delay-2">
        <span class="shine-text">
          Kanduri
        </span>
      </h1>
    </div>

    <script is:inline>
      // Cold-email personalization + Cal.com prompt, driven entirely by
      // ?utm_medium=email&fn=&co=&e= on incoming Apollo links.
      // Self-contained on purpose (Task spec: single script, easy to remove).
      (function () {
        var params = new URLSearchParams(window.location.search);
        var utmMedium = params.get('utm_medium');
        var fn = (params.get('fn') || '').trim();
        var co = (params.get('co') || '').trim();
        var email = (params.get('e') || '').trim();

        var CAL_LINK = 'phaneendra-kanduri/30min';
        var CAL_URL = 'https://cal.com/' + CAL_LINK;
        var calInitialized = false;
        var embedLoaded = false;

        // The <head> script adds .is-cold-email before first paint, which
        // hides #hero-eyebrow / #hero-headline so the personalized copy can
        // be written in without a visible swap. revealHero() undoes that,
        // and is wired to run up front, on DOMContentLoaded, and on a timer
        // so the hero can never stay hidden even if the code below throws.
        function revealHero() {
          ['hero-eyebrow', 'hero-headline'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.style.visibility = 'visible';
          });
        }
        window.addEventListener('DOMContentLoaded', revealHero);
        setTimeout(revealHero, 2000);

        // Official Cal.com embed loader (https://cal.com/docs/embed).
        // Idempotent: safe to call more than once, only injects embed.js once.
        function ensureCalLoaded() {
          if (calInitialized) return;
          calInitialized = true;
          (function (C, A, L) {
            let p = function (a, ar) { a.q.push(ar); };
            let d = C.document;
            C.Cal = C.Cal || function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                let s = d.createElement('script');
                s.src = A;
                // Instrumentation on the official loader so the click
                // handler can fall back to a plain link when embed.js is
                // blocked (adblocker) or never loads.
                s.onload = function () { embedLoaded = true; };
                d.head.appendChild(s);
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () { p(api, arguments); };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === 'string') {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ['initNamespace', namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
          })(window, 'https://app.cal.com/embed/embed.js', 'init');
          window.Cal('init', { origin: 'https://cal.com' });
        }

        function openCalPopup() {
          ensureCalLoaded();
          window.Cal('modal', {
            calLink: CAL_LINK,
            config: {
              name: fn || undefined,
              email: email || undefined,
              theme:
                document.documentElement.getAttribute('data-theme') === 'light'
                  ? 'light'
                  : 'dark',
            },
          });
        }

        // Left-click on the "Book a call" link opens the modal; the link's
        // own href (https://cal.com/…) stays the fallback when JS or the
        // embed fail.
        function handleBookClick(e) {
          if (e && e.preventDefault) e.preventDefault();
          try {
            openCalPopup();
          } catch (err) {
            window.location.href = CAL_URL;
            return;
          }
          // If embed.js hasn't loaded within a few seconds (adblocker,
          // offline, CDN failure), stop waiting and send the visitor to the
          // booking page instead of leaving them on a dead click.
          setTimeout(function () {
            if (!embedLoaded) window.location.href = CAL_URL;
          }, 4000);
        }

        // --- persistent manual CTA: the ONLY way the Cal.com popup opens.
        // Works for any visitor, any time. When ?e= is present its value is
        // used to prefill the booking form (see openCalPopup), but the
        // popup never opens on its own — the visitor must click "Book a call".
        // Delegated on document since #book-call-btn is parsed after this
        // script runs — a direct getElementById here would find nothing.
        // Modifier / non-primary clicks fall through to the link so
        // "open in new tab" keeps working.
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented) return;
          if (e.button && e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (e.target.closest && e.target.closest('#book-call-btn')) {
            handleBookClick(e);
          }
        });

        if (utmMedium !== 'email') {
          revealHero();
          return;
        }

        // --- eyebrow label: swap "Senior Frontend Engineer" for the company ---
        if (co) {
          var eyebrow = document.getElementById('hero-eyebrow');
          if (eyebrow) eyebrow.textContent = co;
        }

        // --- Task 2: personalize the hero headline ---
        // Only the visitor's name gets the shine-text treatment; the rest
        // of the sentence stays plain, inheriting the page's normal text
        // color, so the name is the one thing that pops.
        if (fn) {
          var headline = document.getElementById('hero-headline');
          if (headline) {
            headline.innerHTML = '';
            var h1 = document.createElement('h1');
            h1.className =
              'text-4xl md:text-6xl font-black leading-tight tracking-tight mb-3 animate-fade-up-delay-2';
            h1.appendChild(document.createTextNode('Hi '));
            var span = document.createElement('span');
            span.className = 'shine-text';
            span.textContent = fn;
            h1.appendChild(span);
            h1.appendChild(document.createTextNode('. Got 15 minutes?'));
            headline.appendChild(h1);

            // The headline no longer says who this site belongs to once it
            // greets the visitor by name — reintroduce it as a small line,
            // with my name weighted so it doesn't disappear into the rest.
            var intro = document.createElement('p');
            intro.className = 'text-base md:text-lg text-[color:var(--text-muted)] mb-4 animate-fade-up-delay-3';
            intro.innerHTML =
              "I'm <span class=\"font-semibold shine-text\">Phaneendra Kanduri</span>, frontend engineer at Confluent (an IBM company).";
            headline.insertAdjacentElement('afterend', intro);
          }
        }

        // Personalized copy is in place (or there was nothing to change) —
        // now it's safe to reveal the hero. The Cal.com popup is no longer
        // auto-opened for ?e= links; it opens only on a "Book a call" click,
        // with the ?e= value prefilled into the form at that point.
        revealHero();
      })();
    </script>

    <!-- Rotating value-prop line. aria-hidden because the four lines cycle —
         re-announcing that to screen readers every 3.5s would be worse than
         static text. Line 1's content is repeated once, non-rotating, in
         the .sr-only paragraph right after. Line 1 also ships active in the
         server-rendered HTML, so it's what shows with JS disabled or under
         prefers-reduced-motion (the rotator script never starts a timer in
         that case — see the script below). -->
    <div id="hero-rotator" class="hero-rotator mb-7 animate-fade-up-delay-3" aria-hidden="true">
      {rotatingLines.map((line, i) => (
        <p class={`hero-rotator__line${i === 0 ? ' is-active' : ''}`}>
          <span class="hero-rotator__quote">{line}</span>
        </p>
      ))}
    </div>
    <p class="sr-only">{rotatingLines[0]}</p>

    <div class="hero-metrics mb-8 animate-fade-up-delay-3" aria-label="Performance metrics">
      <span class="hero-metric">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span class="mono">2s → 0.2s FCP</span>
      </span>
      <span class="hero-metric-sep" aria-hidden="true">·</span>
      <span class="hero-metric">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>
        <span class="mono">20min → 1.5min builds</span>
      </span>
      <span class="hero-metric-sep" aria-hidden="true">·</span>
      <span class="hero-metric">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="mono">30s → 5s load</span>
      </span>
    </div>

    <!-- Industries + availability, as chips rather than dot-separated text —
         each fact gets its own bounded shape and a small icon, so this
         block reads as distinct pieces of information instead of one long
         run-on line. -->
    <div class="hero-chips mb-3 animate-fade-up-delay-3" aria-label="Industries">
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
        Enterprise SaaS
      </span>
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Healthcare
      </span>
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        HR Tech
      </span>
    </div>

    <div class="hero-chips mb-9 animate-fade-up-delay-3" aria-label="Availability">
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Willing to relocate
      </span>
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Visa sponsorship required
      </span>
      <span class="hero-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Notice period: 30 days
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-7">
      <a
        id="resume-btn"
        href="/resume/Phaneendra_Kanduri_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline inline-flex items-center gap-2 text-sm font-semibold tracking-wide px-7 py-3.5 rounded-full border transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        View Résumé
      </a>
      <a
        id="book-call-btn"
        href="https://cal.com/phaneendra-kanduri/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="shiny-cta inline-flex items-center gap-2 text-sm font-semibold tracking-wide px-7 py-3.5 rounded-full border text-[color:var(--heading)] transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Got 15 minutes? →
      </a>
    </div>

    <div class="social-row flex justify-center gap-3 animate-fade-up-delay-4">
      <a href="https://github.com/9thQuadrant" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
        class="icon-link">
        <!-- GitHub icon -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/phaneendracharyulu" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
        class="icon-link">
        <!-- LinkedIn icon -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="https://dev.to/9thquadrant" target="_blank" rel="noopener noreferrer" aria-label="Dev.to blog"
        class="icon-link">
        <!-- Code brackets — stroke weight matched to the other three icons -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        </svg>
      </a>
      <a href="mailto:phaneendra@9thquadrant.com" aria-label="Email"
        class="icon-link">
        <!-- Mail icon -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
    </div>

    <a href="#experience" id="scroll-cue" aria-label="Scroll down to see experience">
      <span class="scroll-cue__text">Scroll</span>
      <span class="scroll-cue__chevrons" aria-hidden="true">
        <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 3 14 9 25 3"/></svg>
        <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 3 14 9 25 3"/></svg>
        <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 3 14 9 25 3"/></svg>
      </span>
    </a>
  </section>
  <script is:inline>
    // GA4 doesn't reliably auto-track outbound file downloads unless
    // "File downloads" is switched on under Enhanced measurement in the
    // GA4 property admin — and even then it's a heuristic, not guaranteed.
    // Firing the event explicitly on click means it's tracked either way.
    // Uses GA4's own recommended file_download schema so it lines up with
    // whatever Enhanced measurement would have sent.
    (function () {
      var btn = document.getElementById('resume-btn');
      if (!btn) return;
      btn.addEventListener('click', function () {
        if (typeof gtag !== 'function') return;
        gtag('event', 'file_download', {
          file_name: 'Phaneendra_Kanduri_Resume.pdf',
          file_extension: 'pdf',
          link_url: btn.href,
          link_text: btn.textContent.trim(),
        });
      });
    })();
  </script>
  <script is:inline>
    // fade the scroll cue out once the visitor has clearly started scrolling
    (function () {
      var cue = document.getElementById('scroll-cue');
      if (!cue) return;
      var hidden = false;
      window.addEventListener(
        'scroll',
        function () {
          var should = window.scrollY > 60;
          if (should !== hidden) {
            hidden = should;
            cue.classList.toggle('is-hidden', should);
          }
        },
        { passive: true }
      );
    })();
  </script>
  <script is:inline>
    // Hero rotator: cycles the four value-prop lines every 3.5s.
    // Respects prefers-reduced-motion by never starting a timer at all —
    // line 1 (already active in the server-rendered HTML) just stays put.
    // Pauses on hover/focus of the hero (#top) and resumes on leave/blur.
    (function () {
      var root = document.getElementById('hero-rotator');
      if (!root) return;
      var lines = root.querySelectorAll('.hero-rotator__line');
      if (lines.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var idx = 0;
      var timer = null;

      function show(next) {
        // Odometer-style swap: the outgoing line keeps travelling upward
        // (is-leaving) while the incoming one rises from below into the
        // active slot — both moving the same direction, like a rolling
        // counter. Once the outgoing line's transition is done it's reset
        // to its resting position (below, no transition) so it's ready to
        // rise in again on its next turn.
        var outgoing = lines[idx];
        outgoing.classList.remove('is-active');
        outgoing.classList.add('is-leaving');
        window.setTimeout(function () {
          outgoing.classList.remove('is-leaving');
          outgoing.style.transition = 'none';
          void outgoing.offsetWidth; // force reflow before re-enabling the transition
          outgoing.style.transition = '';
        }, 520);

        idx = next;
        lines[idx].classList.add('is-active');
      }
      function tick() {
        show((idx + 1) % lines.length);
      }
      function start() {
        if (!timer) timer = setInterval(tick, 3500);
      }
      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      start();

      var hero = document.getElementById('top');
      if (hero) {
        hero.addEventListener('mouseenter', stop);
        hero.addEventListener('mouseleave', start);
        hero.addEventListener('focusin', stop);
        hero.addEventListener('focusout', start);
      }
    })();
  </script>

  <!-- Experience -->
  <section id="experience" class="relative z-10 py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="section-label">Experience</p>
      <div class="space-y-14">
        {experiences.map((exp) => (
          <div class="grad-bar group border-l border-[color:var(--border)] pl-6 transition-colors duration-300">
            <div class="flex flex-wrap justify-between items-start gap-3 mb-4">
              <div>
                <h3 class="text-xl font-bold text-[color:var(--heading)]">{exp.company}</h3>
                <p class="text-[color:var(--link)] text-sm font-medium mt-0.5">{exp.role}</p>
              </div>
              <div class="w-full sm:w-auto text-left sm:text-right">
                <p class="text-xs font-medium tracking-wide text-[color:var(--text-muted)]">{exp.period}</p>
                <p class="text-xs text-[color:var(--text-faint)]">{exp.location}</p>
              </div>
            </div>
            <ul class="space-y-2.5">
              {exp.achievements.map((a) => (
                <li class="text-[color:var(--text-secondary)] text-sm leading-relaxed flex gap-3">
                  <span class="bullet-dot"></span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="section-label">Skills</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {skills.map((group) => (
          <div class="grad-edge border border-[color:var(--border-solid)] rounded-lg p-5 transition-colors duration-200">
            <p class="skill-card-title">{group.title}</p>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="text-sm text-[color:var(--text-secondary)]">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Links -->
  <section id="writing" class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="section-label">Around the web</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map((link) => (
          <a href={link.href} target={link.href !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="grad-edge flex items-center justify-between border border-[color:var(--border-solid)] rounded-lg px-5 py-4 group transition-all duration-200">
            <div>
              <p class="text-sm font-semibold text-[color:var(--heading)] group-hover:text-[color:var(--link)] transition-colors">{link.label}</p>
              <p class="text-xs text-[color:var(--text-muted)] mt-0.5">{link.sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              class="text-[color:var(--text-faint)] group-hover:text-[color:var(--link)] transition-colors"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer id="contact" class="grad-top relative z-10 py-10 px-6 text-center">
    <a href="mailto:phaneendra@9thquadrant.com"
      class="text-sm text-[color:var(--text-muted)] hover:text-[color:var(--link)] transition-colors">
      phaneendra@9thquadrant.com
    </a>
  </footer>
</Base>

<style is:global>
  /* is:global (not Astro's default scoped style): .shine-text gets applied
     to spans created at runtime via document.createElement in the
     personalization script, which never receive Astro's scope attribute —
     a scoped rule would silently never match them. */
  .icon-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-solid);
    color: var(--text-muted);
    transition: border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  /* same gradient-ring-on-hover treatment as the cards, so the social row
     reads as part of the palette rather than a set of grey chips */
  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    background: var(--grad-gemini);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .icon-link:hover {
    border-color: transparent;
    color: var(--heading);
    box-shadow: 0 0 22px -8px rgba(155, 114, 203, 0.9);
  }

  .icon-link:hover::before {
    opacity: 1;
  }

  /* ---- Aurora --------------------------------------------------------
     Full-width band at the top of the page. Each curtain is a soft
     blurred blob in an aurora hue, drifting on its own slow loop and
     blended additively (screen) in dark mode so overlaps brighten like
     real aurora; in light mode it switches to multiply at low opacity so
     it lands as a faint pastel wash instead of blowing out to white. */
  #aurora-wrap {
    /* absolute (not fixed) so the aurora belongs to the hero and scrolls
       away with it, rather than tinting every section as you move down */
    position: absolute;
    top: -128px; /* was -160px — brought down 20% */
    left: 0;
    right: 0;
    height: min(66vh, 600px);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 1;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 28%, transparent 97%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 28%, transparent 97%);
  }

  #aurora {
    position: relative;
    width: 100%;
    height: 100%;
    /* gentle cursor parallax — the band as a whole eases opposite the pointer */
    transform: translate3d(
      calc(var(--mx, 0px) * -0.14),
      calc(var(--my, 0px) * -0.09),
      0
    );
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .aurora-band {
    position: absolute;
    top: -55%;
    height: 170%;
    border-radius: 45% 55% 62% 38%;
    /* less blur than the travel distance, otherwise the drift is invisible */
    filter: blur(46px) saturate(var(--aurora-saturate));
    mix-blend-mode: var(--aurora-blend);
    opacity: var(--aurora-opacity);
    will-change: transform;
  }
  .aurora-band--1 {
    left: -24%;
    width: 58%;
    background: radial-gradient(closest-side at 50% 45%, var(--aurora-1), transparent 100%);
    animation: aurora-1 17s ease-in-out infinite alternate;
  }
  .aurora-band--2 {
    left: 18%;
    width: 62%;
    background: radial-gradient(closest-side at 50% 55%, var(--aurora-2), transparent 100%);
    animation: aurora-2 21s ease-in-out infinite alternate;
  }
  .aurora-band--3 {
    left: 52%;
    width: 60%;
    background: radial-gradient(closest-side at 50% 42%, var(--aurora-3), transparent 100%);
    animation: aurora-3 19s ease-in-out infinite alternate;
  }

  /* big amplitude on purpose — the curtains sweep a long way and morph
     shape so the movement reads clearly through the blur */
  @keyframes aurora-1 {
    from { transform: translate3d(-28%, -8%, 0) rotate(-18deg) scale(1, 1); }
    to   { transform: translate3d(34%, 10%, 0) rotate(10deg) scale(0.82, 1.4); }
  }
  @keyframes aurora-2 {
    from { transform: translate3d(26%, 6%, 0) rotate(14deg) scale(1.1, 1.2); }
    to   { transform: translate3d(-30%, -6%, 0) rotate(-12deg) scale(0.85, 0.9); }
  }
  @keyframes aurora-3 {
    from { transform: translate3d(16%, 0, 0) rotate(-8deg) scale(1, 1); }
    to   { transform: translate3d(-34%, 12%, 0) rotate(16deg) scale(1.15, 1.35); }
  }

  /* entrance is only a `from` keyframe with no fill-mode, so the element
     always settles back to its own opacity:1 once the 1.3s is up — it can
     never get stuck hidden */
  #aurora-wrap {
    animation: aurora-enter 1.3s ease-out;
  }
  @keyframes aurora-enter {
    from { opacity: 0; transform: translateY(-40px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora-band { animation: none; }
  }

  /* ---- hero rotator --------------------------------------------------
     Fixed-height stage so the four lines crossfade in place with zero
     layout shift. Every line is absolutely positioned inside the stage
     (so only min-height, not content, drives the box's size); the
     .is-active one gets opacity:1. Line 1 ships .is-active from the
     server, which is also what prefers-reduced-motion and no-JS visitors
     see, permanently. */
  .hero-rotator {
    position: relative;
    /* explicit width: every line inside is absolutely positioned (so they
       can crossfade in place), which means the rotator has no in-flow
       content to size itself from — without this it collapses to zero
       width in the hero's centered flex column. */
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    /* dedicated, fixed stage height (not responsive) — every line, at any
       viewport width, crossfades/slides within this box with zero shift */
    min-height: 150px;
    /* clips the odometer slide — lines travel past the box edge on their
       way in/out rather than spilling into neighbouring content */
    overflow: hidden;
  }
  /* Odometer-style rotation: the active line sits at rest; the next line
     rises up from below to replace it, while the outgoing line keeps
     travelling up and out — same direction throughout, like a rolling
     counter, rather than a plain crossfade. .is-leaving is added/removed
     by the rotator script (see the inline script after this section) once
     each swap's transition finishes, so an outgoing line is always reset
     below (its default rest position) before its next turn. */
  .hero-rotator__line {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'DM Mono', 'JetBrains Mono', 'Cascadia Code', monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.625;
    color: var(--text);
    opacity: 0;
    transform: translateY(65%);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.35s ease;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .hero-rotator__line {
      font-size: 1.25rem;
    }
  }
  /* Real curly quote marks flanking the line, sized up and lightly
     tinted so they read as a proper pull-quote rather than plain punctuation.
     Part of the inline text (not separate flex items), so they wrap and
     stay glued to the sentence exactly like typography would. */
  .hero-rotator__quote::before,
  .hero-rotator__quote::after {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: normal;
    font-weight: 700;
    font-size: 1.3em;
    color: var(--link);
    opacity: 0.65;
    vertical-align: -0.08em;
  }
  .hero-rotator__quote::before {
    content: '\201C';
    margin-right: 0.15em;
  }
  .hero-rotator__quote::after {
    content: '\201D';
    margin-left: 0.15em;
  }
  .hero-rotator__line.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  .hero-rotator__line.is-leaving {
    opacity: 0;
    transform: translateY(-65%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rotator__line {
      transition: none;
    }
  }

  /* ---- hero metrics ----------------------------------------------------
     Each stat gets its own small icon (lightning/wrench/clock) so the row
     reads as three distinct proof points instead of one dense mono string. */
  .hero-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    font-weight: 400;
    color: var(--heading);
  }
  .hero-metric {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
  }
  @media (min-width: 768px) {
    .hero-metric {
      font-size: 1.125rem;
    }
  }
  .hero-metric svg {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--link);
  }
  .hero-metric-sep {
    color: var(--text-faint);
    font-weight: 400;
  }

  /* ---- hero chips ------------------------------------------------------
     Industries + availability as individual pill shapes with a small icon
     each, instead of one long dot-separated line — breaks the hero's lower
     half into distinct, scannable pieces instead of a wall of text. */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border-solid);
    background: var(--surface);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .hero-chip svg {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--link);
  }

  /* ---- secondary CTA (outline) — sits next to .shiny-cta, deliberately
     quieter: no gradient border, no glow, just a border that picks up the
     link colour on hover. */
  .btn-outline {
    border-color: var(--border-solid);
    color: var(--text-secondary);
    background: transparent;
    /* matches .shiny-cta's own entrance timing so both buttons in the
       CTA row fade up together */
    animation: fade-up 0.7s 0.5s ease-out both;
  }
  .btn-outline:hover {
    border-color: var(--link);
    color: var(--heading);
    background: var(--surface);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-outline { animation: fade-up 0.7s 0.5s ease-out both; }
  }

  /* ---- social row — smaller than the header icon row (still secondary
     to the CTAs above), but with a real fill and solid contrast so they
     don't read as barely-there ghosts. */
  .social-row .icon-link {
    width: 36px;
    height: 36px;
    background: var(--surface);
    color: var(--text-secondary);
  }
  .social-row .icon-link:hover {
    background: var(--surface-hover);
  }

  /* ---- section eyebrows --------------------------------------------- */
  /* Hero eyebrow: gradient text with an ink halo so it survives sitting
     directly under the aurora. */
  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    background-image: var(--grad-gemini);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 10px var(--shadow-ink))
            drop-shadow(0 0 3px var(--shadow-ink));
  }

  /* Section headings ("Experience", "Skills", "Around the web"):
     solid high-contrast colour + a short gradient bar for palette
     cohesion. Much more legible than the old faint gradient-on-glow. */
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--label);
    margin-bottom: 3.5rem;
  }
  .section-label::before {
    content: "";
    flex: none;
    width: 1.75rem;
    height: 3px;
    border-radius: 3px;
    background: var(--grad-gemini);
  }

  /* Skill-card headings — near heading-level contrast so each group name
     reads at a glance. */
  .skill-card-title {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--heading);
    margin-bottom: 0.85rem;
  }

  /* ---- scroll cue --------------------------------------------------- */
  /* Deliberately loud: a "SCROLL" label plus three chevrons that cascade
     downward on a loop, tinted in the link colour with a soft glow so it
     reads as an obvious affordance. Fades out once the visitor scrolls. */
  #scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--link);
    transition: opacity 0.4s ease, visibility 0.4s ease, color 0.2s ease;
  }
  #scroll-cue:hover {
    color: var(--heading);
  }
  #scroll-cue.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* "Sonar" ripple: a ring that starts enclosing the whole SCROLL +
     chevrons element, drifts out ~100px, and dissolves as it goes. Two
     rings half a cycle apart so there's always one travelling. */
  #scroll-cue::before,
  #scroll-cue::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96px; /* encloses the label + chevrons */
    height: 96px;
    margin: -48px 0 0 -48px;
    border-radius: 50%;
    border: 2px solid var(--link);
    background: radial-gradient(circle, var(--cue-glow) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
    /* 4s life, two rings 2s apart → a new ripple emanates every 2 seconds */
    animation: cue-ripple 4s ease-out infinite;
  }
  #scroll-cue::after {
    animation-delay: 2s;
  }

  /* scale 2 × 96px ≈ 192px → ~48px of travel past the 96px start; opacity
     is front-loaded so the ring is bright at the origin and nearly gone by
     the time it has expanded */
  @keyframes cue-ripple {
    0%   { transform: scale(0.92); opacity: 0; }
    12%  { opacity: 0.8; }
    55%  { opacity: 0.06; }
    100% { transform: scale(2); opacity: 0; }
  }

  .scroll-cue__text {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    text-shadow: 0 0 14px var(--cue-glow);
    animation: cue-text-pulse 2s ease-in-out infinite;
  }

  .scroll-cue__chevrons {
    position: relative;
    width: 32px;
    height: 24px;
    filter: drop-shadow(0 0 10px var(--cue-glow));
  }
  .scroll-cue__chevrons svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 13px;
    opacity: 0;
    animation: cue-chev 1.7s ease-in-out infinite;
  }
  .scroll-cue__chevrons svg:nth-child(2) { animation-delay: 0.2s; }
  .scroll-cue__chevrons svg:nth-child(3) { animation-delay: 0.4s; }

  @keyframes cue-chev {
    0%   { opacity: 0; transform: translateY(-6px); }
    35%  { opacity: 1; }
    70%  { opacity: 0; transform: translateY(12px); }
    100% { opacity: 0; transform: translateY(12px); }
  }
  @keyframes cue-text-pulse {
    0%, 100% { opacity: 0.6; }
    50%      { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue__chevrons svg { animation: none; opacity: 0.9; }
    .scroll-cue__chevrons svg:nth-child(1) { top: -2px; }
    .scroll-cue__chevrons svg:nth-child(2) { top: 5px; }
    .scroll-cue__chevrons svg:nth-child(3) { top: 12px; }
    .scroll-cue__text { animation: none; opacity: 1; }
    #scroll-cue::before,
    #scroll-cue::after { animation: none; opacity: 0.25; transform: scale(1.3); }
  }

  /* Reusable gradient outline that fades in on hover, for bordered cards.
     Lives on ::before with a mask so only the 1px edge is painted and the
     card's own content shows through untouched. */
  .grad-edge {
    position: relative;
    background: var(--surface);
    box-shadow: var(--card-shadow);
    transition: background 0.25s ease, box-shadow 0.35s ease;
  }
  .grad-edge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--grad-gemini);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .grad-edge:hover::before {
    opacity: 1;
  }
  .grad-edge:hover {
    background: var(--surface-hover);
    box-shadow: 0 0 34px -14px rgba(155, 114, 203, 0.55);
  }

  /* Gradient left-rail for the experience entries — the flat slate border
     becomes a vertical spectrum bar that intensifies on hover. */
  .grad-bar {
    position: relative;
    border-left-color: transparent;
  }
  .grad-bar::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--g1), var(--g2), var(--g3), var(--g4));
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }
  .grad-bar:hover::before {
    opacity: 1;
  }

  /* Small gradient dot that replaces the near-invisible slate "–" marker
     on every achievement bullet. */
  .bullet-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 7px;
    border-radius: 9999px;
    background: var(--grad-gemini);
  }

  /* Hairline gradient rule along the top of the footer, echoing the
     card edges. */
  .grad-top {
    position: relative;
  }
  .grad-top::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--grad-gemini);
    opacity: 0.5;
  }

  /* "lets talk!" CTA — the loudest expression of the palette: a gradient
     border whose colors flow around the pill, a light sweep that travels
     across it, and a coloured halo that breathes underneath. Every effect
     is on a pseudo-element / box-shadow so the label text is never tinted.
     Durations are deliberately slow so it feels ambient, not busy. */
  .shiny-cta {
    position: relative;
    isolation: isolate;
    border-color: transparent;
    background: rgba(155, 114, 203, 0.12);
    /* entrance fade (was the .animate-fade-up-delay-4 utility) + the
       continuous breathing halo, composed so both survive. */
    animation:
      fade-up 0.7s 0.5s ease-out both,
      cta-halo 7s ease-in-out infinite;
  }
  .shiny-cta:hover {
    background: rgba(155, 114, 203, 0.2);
  }

  /* flowing gradient border */
  .shiny-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 3.5px;
    background: linear-gradient(
      115deg,
      var(--g1), var(--g2), var(--g3), var(--g4), var(--g1)
    );
    background-size: 300% 100%;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: cta-border-flow 10s linear infinite;
    z-index: -1;
  }

  /* travelling light sweep */
  .shiny-cta::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 255, 255, 0.5) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    background-position: -160% 0;
    animation: cta-shine-sweep 8s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes cta-border-flow {
    to { background-position: 300% 0; }
  }

  @keyframes cta-shine-sweep {
    0%        { background-position: -160% 0; }
    45%, 100% { background-position: 300% 0; }
  }

  @keyframes cta-halo {
    0%, 100% {
      box-shadow:
        0 0 22px -6px rgba(66, 133, 244, 0.55),
        0 0 40px -12px rgba(217, 101, 112, 0.4);
    }
    50% {
      box-shadow:
        0 0 34px -4px rgba(155, 114, 203, 0.7),
        0 0 64px -10px rgba(249, 171, 85, 0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiny-cta { animation: fade-up 0.7s 0.5s ease-out both; }
    .shiny-cta::before { animation: none; }
    .shiny-cta::after { display: none; }
  }

  .shine-text {
    /* Linear (not conic): a conic gradient has a centre vertex where the
       bands converge, which shows as a seam in the text. The stops are
