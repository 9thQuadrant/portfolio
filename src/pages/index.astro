---
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import { experiences, skills, links } from '../data/content';
---

<Base>
  <Stars />

  <!-- Ambient glow: sits at the top of the page, descends into view on
       load, and reacts to mouse movement like a water surface being
       disturbed. Three nested layers, each owning exactly one transform /
       effect so nothing fights:
         #mouse-glow-wrap  – fixed placement + one-time entrance animation
         #mouse-glow       – continuous mouse-reactive translate/scale
         #mouse-glow-core  – the coloured blob: static blur (cached once)
                             + a slow compositor-only rotate, so the colour
                             cycle never re-rasterizes the blur on scroll.
       Self-contained and independent of the cold-email script. -->
  <div id="mouse-glow-wrap" aria-hidden="true">
    <div id="mouse-glow">
      <div id="mouse-glow-core"></div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var glow = document.getElementById('mouse-glow');
      if (!glow) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // --mx/--my live on the root element (not just the glow) so any
      // .shine-text element elsewhere on the page — the gradient name text
      // — can read the same cursor position via CSS inheritance.
      var root = document.documentElement;
      var raf = null;
      var settleTimer = null;
      window.addEventListener(
        'mousemove',
        function (e) {
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = null;
            var dx = (e.clientX / window.innerWidth - 0.5) * 180;
            var dy = (e.clientY / window.innerHeight - 0.5) * 100;
            root.style.setProperty('--mx', dx.toFixed(1) + 'px');
            root.style.setProperty('--my', dy.toFixed(1) + 'px');
            // A little swell on movement, like a surface being disturbed —
            // settles back once the cursor stops.
            glow.style.setProperty('--s', '1.08');
          });
          clearTimeout(settleTimer);
          settleTimer = setTimeout(function () {
            glow.style.setProperty('--s', '1');
          }, 250);
        },
        { passive: true }
      );
    })();
  </script>

  <!-- Hero -->
  <section class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <p id="hero-eyebrow" class="grad-label mono text-xs uppercase tracking-[0.3em] mb-6 animate-fade-up-delay-1">
      Senior Frontend Engineer
    </p>

    <div id="hero-headline">
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-2 animate-fade-up-delay-2">
        <span class="bg-gradient-to-r from-white via-slate-200 to-slate-300 bg-clip-text text-transparent">
          Phaneendra
        </span>
      </h1>
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-10 animate-fade-up-delay-2">
        <span class="shine-text">
          Kanduri
        </span>
      </h1>
    </div>

    <script is:inline>
      // Cold-email personalization + Cal.com prompt, driven entirely by
      // ?utm_medium=email&fn=&co=&e= on incoming Apollo links.
      // Self-contained on purpose (Task spec: single script, easy to remove).
      (function () {
        var params = new URLSearchParams(window.location.search);
        var utmMedium = params.get('utm_medium');
        var fn = (params.get('fn') || '').trim();
        var co = (params.get('co') || '').trim();
        var email = (params.get('e') || '').trim();

        var CAL_LINK = 'phaneendra-kanduri/30min';
        var CAL_URL = 'https://cal.com/' + CAL_LINK;
        var calInitialized = false;
        var embedLoaded = false;

        // The <head> script adds .is-cold-email before first paint, which
        // hides #hero-eyebrow / #hero-headline so the personalized copy can
        // be written in without a visible swap. revealHero() undoes that,
        // and is wired to run up front, on DOMContentLoaded, and on a timer
        // so the hero can never stay hidden even if the code below throws.
        function revealHero() {
          ['hero-eyebrow', 'hero-headline'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.style.visibility = 'visible';
          });
        }
        window.addEventListener('DOMContentLoaded', revealHero);
        setTimeout(revealHero, 2000);

        // Official Cal.com embed loader (https://cal.com/docs/embed).
        // Idempotent: safe to call more than once, only injects embed.js once.
        function ensureCalLoaded() {
          if (calInitialized) return;
          calInitialized = true;
          (function (C, A, L) {
            let p = function (a, ar) { a.q.push(ar); };
            let d = C.document;
            C.Cal = C.Cal || function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                let s = d.createElement('script');
                s.src = A;
                // Instrumentation on the official loader so the click
                // handler can fall back to a plain link when embed.js is
                // blocked (adblocker) or never loads.
                s.onload = function () { embedLoaded = true; };
                d.head.appendChild(s);
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () { p(api, arguments); };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === 'string') {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ['initNamespace', namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
          })(window, 'https://app.cal.com/embed/embed.js', 'init');
          window.Cal('init', { origin: 'https://cal.com' });
        }

        function openCalPopup() {
          ensureCalLoaded();
          window.Cal('modal', {
            calLink: CAL_LINK,
            config: {
              name: fn || undefined,
              email: email || undefined,
              theme: 'dark',
            },
          });
        }

        // Left-click on the "Book a call" link opens the modal; the link's
        // own href (https://cal.com/…) stays the fallback when JS or the
        // embed fail.
        function handleBookClick(e) {
          if (e && e.preventDefault) e.preventDefault();
          try {
            openCalPopup();
          } catch (err) {
            window.location.href = CAL_URL;
            return;
          }
          // If embed.js hasn't loaded within a few seconds (adblocker,
          // offline, CDN failure), stop waiting and send the visitor to the
          // booking page instead of leaving them on a dead click.
          setTimeout(function () {
            if (!embedLoaded) window.location.href = CAL_URL;
          }, 4000);
        }

        // --- persistent manual CTA: the ONLY way the Cal.com popup opens.
        // Works for any visitor, any time. When ?e= is present its value is
        // used to prefill the booking form (see openCalPopup), but the
        // popup never opens on its own — the visitor must click "Book a call".
        // Delegated on document since #book-call-btn is parsed after this
        // script runs — a direct getElementById here would find nothing.
        // Modifier / non-primary clicks fall through to the link so
        // "open in new tab" keeps working.
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented) return;
          if (e.button && e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (e.target.closest && e.target.closest('#book-call-btn')) {
            handleBookClick(e);
          }
        });

        if (utmMedium !== 'email') {
          revealHero();
          return;
        }

        // --- eyebrow label: swap "Senior Frontend Engineer" for the company ---
        if (co) {
          var eyebrow = document.getElementById('hero-eyebrow');
          if (eyebrow) eyebrow.textContent = co;
        }

        // --- Task 2: personalize the hero headline ---
        // Only the visitor's name gets the shine-text treatment; the rest
        // of the sentence stays plain, inheriting the page's normal text
        // color, so the name is the one thing that pops.
        if (fn) {
          var headline = document.getElementById('hero-headline');
          if (headline) {
            headline.innerHTML = '';
            var h1 = document.createElement('h1');
            h1.className =
              'text-4xl md:text-6xl font-black leading-tight tracking-tight mb-10 animate-fade-up-delay-2';
            h1.appendChild(document.createTextNode('Hi '));
            var span = document.createElement('span');
            span.className = 'shine-text';
            span.textContent = fn;
            h1.appendChild(span);
            h1.appendChild(document.createTextNode('. Got 15 minutes?'));
            headline.appendChild(h1);

            // The headline no longer says who this site belongs to once it
            // greets the visitor by name — reintroduce it as a small line,
            // with my name weighted so it doesn't disappear into the rest.
            var intro = document.createElement('p');
            intro.className = 'text-sm text-slate-400 mb-4 animate-fade-up-delay-3';
            intro.innerHTML =
              "I'm <span class=\"font-semibold shine-text\">Phaneendra Kanduri</span>, frontend engineer at Confluent (an IBM company).";
            headline.insertAdjacentElement('afterend', intro);
          }
        }

        // Personalized copy is in place (or there was nothing to change) —
        // now it's safe to reveal the hero. The Cal.com popup is no longer
        // auto-opened for ?e= links; it opens only on a "Book a call" click,
        // with the ?e= value prefilled into the form at that point.
        revealHero();
      })();
    </script>

    <p class="text-base md:text-lg text-slate-400 max-w-lg mx-auto mb-4 leading-relaxed animate-fade-up-delay-3">
      9+ years turning slow, legacy frontends into fast, accessible products
      for regulated industries and Fortune 500 teams.
    </p>

    <p class="mono text-xs text-slate-200 mb-3 animate-fade-up-delay-3">
      2s → 0.2s FCP &nbsp;·&nbsp; 20min → 1.5min builds &nbsp;·&nbsp; 30s → 5s load
    </p>

    <p class="mono text-xs text-slate-200 mb-10 animate-fade-up-delay-3">
      Enterprise SaaS &nbsp;·&nbsp; Healthcare &nbsp;·&nbsp; HR Tech
    </p>

    <a
      id="book-call-btn"
      href="https://cal.com/phaneendra-kanduri/30min"
      target="_blank"
      rel="noopener noreferrer"
      class="shiny-cta inline-block mono text-sm lowercase tracking-wide px-7 py-3.5 mb-8 rounded-full border text-white transition-colors"
    >
      let's talk!
    </a>

    <div class="flex justify-center gap-4 animate-fade-up-delay-4">
      <a href="https://github.com/9thQuadrant" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
        class="icon-link">
        <!-- GitHub icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/phaneendracharyulu" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
        class="icon-link">
        <!-- LinkedIn icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="mailto:phaneendra@9thquadrant.com" aria-label="Email"
        class="icon-link">
        <!-- Mail icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
      <a href="https://dev.to/9thquadrant" target="_blank" rel="noopener noreferrer" aria-label="Dev.to blog"
        class="icon-link">
        <!-- Code brackets — stroke weight matched to the other three icons -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        </svg>
      </a>
    </div>

    <div class="absolute bottom-10 left-1/2 animate-bob" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        class="text-slate-600" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
      </svg>
    </div>
  </section>

  <!-- Experience -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="grad-label mono text-xs uppercase tracking-[0.3em] mb-14">Experience</p>
      <div class="space-y-14">
        {experiences.map((exp) => (
          <div class="grad-bar group border-l border-slate-800 pl-6 transition-colors duration-300">
            <div class="flex flex-wrap justify-between items-start gap-3 mb-4">
              <div>
                <h3 class="text-xl font-bold text-white">{exp.company}</h3>
                <p class="text-blue-400 text-sm mt-0.5">{exp.role}</p>
              </div>
              <div class="w-full sm:w-auto text-left sm:text-right">
                <p class="mono text-xs text-slate-500">{exp.period}</p>
                <p class="mono text-xs text-slate-500">{exp.location}</p>
              </div>
            </div>
            <ul class="space-y-2.5">
              {exp.achievements.map((a) => (
                <li class="text-slate-400 text-sm leading-relaxed flex gap-3">
                  <span class="bullet-dot"></span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="grad-label mono text-xs uppercase tracking-[0.3em] mb-14">Skills</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {skills.map((group) => (
          <div class="grad-edge border border-slate-700 rounded-lg p-5 transition-colors duration-200">
            <p class="mono text-xs uppercase tracking-widest text-slate-400 mb-3">{group.title}</p>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="text-sm text-slate-300">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Links -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="grad-label mono text-xs uppercase tracking-[0.3em] mb-14">Around the web</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map((link) => (
          <a href={link.href} target={link.href !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="grad-edge flex items-center justify-between border border-slate-700 rounded-lg px-5 py-4 group transition-all duration-200">
            <div>
              <p class="text-sm font-medium text-white group-hover:text-blue-400 transition-colors">{link.label}</p>
              <p class="mono text-xs text-slate-400 mt-0.5">{link.sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              class="text-slate-500 group-hover:text-blue-400 transition-colors"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="grad-top relative z-10 py-10 px-6 text-center">
    <a href="mailto:phaneendra@9thquadrant.com"
      class="mono text-xs text-slate-400 hover:text-blue-400 transition-colors">
      phaneendra@9thquadrant.com
    </a>
  </footer>
</Base>

<style is:global>
  /* is:global (not Astro's default scoped style): .shine-text gets applied
     to spans created at runtime via document.createElement in the
     personalization script, which never receive Astro's scope attribute —
     a scoped rule would silently never match them. */
  .icon-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(51 65 85); /* slate-700 */
    color: rgb(148 163 184); /* slate-400 */
    transition: border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  /* same gradient-ring-on-hover treatment as the cards, so the social row
     reads as part of the palette rather than a set of grey chips */
  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    background: var(--grad-gemini);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .icon-link:hover {
    border-color: transparent;
    color: #fff;
    box-shadow: 0 0 22px -8px rgba(155, 114, 203, 0.9);
  }

  .icon-link:hover::before {
    opacity: 1;
  }

  #mouse-glow-wrap {
    position: fixed;
    top: -280px;
    left: 50%;
    width: 640px;
    height: 420px;
    transform: translate(-50%, 0);
    pointer-events: none;
    z-index: 1;
    opacity: 1;
  }

  #mouse-glow {
    position: relative;
    width: 100%;
    height: 100%;
    /* Position follows the cursor; scale gives it a brief "swell" on
       movement, like a disturbed water surface — the elastic easing lets
       it overshoot slightly and settle rather than snapping into place. */
    transform: translate(var(--mx, 0px), var(--my, 0px)) scale(var(--s, 1));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
  }

  #mouse-glow-core {
    position: absolute;
    /* larger than the wrapper so the rotating rectangle's corners never
       sweep into view */
    inset: -20%;
    background: conic-gradient(from 0deg, #4285f4, #9b72cb, #d96570, #f9ab55, #4285f4);
    /* static blur → the browser rasterizes the blurred blob once and then
       just composites the rotation; screen blend makes it emit light
       against the near-black page instead of sitting as a dark smear */
    filter: blur(76px);
    opacity: 0.6;
    mix-blend-mode: screen;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    #mouse-glow-wrap {
      opacity: 0;
      animation: mouse-glow-enter 1s ease-out forwards;
    }

    #mouse-glow-core {
      animation: mouse-glow-spin 44s linear infinite;
    }
  }

  @keyframes mouse-glow-enter {
    from { opacity: 0; transform: translate(-50%, -120px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }

  @keyframes mouse-glow-spin {
    to { transform: rotate(360deg); }
  }

  /* Same idea as the ambient glow, applied to text: a gradient bigger than
     the text itself, panned by the same --mx/--my the glow uses, so both
     shift together with the cursor. Falls back to a static gradient with
     no motion if reduced-motion is set (the --mx/--my custom properties
     are simply never updated in that case). */
  /* --- Gemini-inspired gradient system ---------------------------------
     One 4-stop spectrum — Google blue → Gemini purple → coral → warm
     amber — reused by every accent on the page (name text, ambient glow,
     CTA, card edges) so the whole site reads as one palette rather than
     a set of unrelated blue highlights. See
     design.google/library/gemini-ai-visual-design. */
  :root {
    --g1: #4285f4; /* blue   */
    --g2: #9b72cb; /* purple */
    --g3: #d96570; /* coral  */
    --g4: #f9ab55; /* amber  */
    --grad-gemini: linear-gradient(115deg, var(--g1), var(--g2), var(--g3), var(--g4));
  }

  /* Static gradient text — for the small section eyebrows. (The hero name
     uses .shine-text below, which additionally tracks the cursor.) */
  .grad-label {
    background-image: var(--grad-gemini);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* dark halo so the gradient stays legible where it sits directly over
       the ambient glow (which is painted from the same four colours) */
    filter: drop-shadow(0 0 12px rgba(2, 4, 9, 0.95))
            drop-shadow(0 0 4px rgba(2, 4, 9, 1));
  }

  /* Reusable gradient outline that fades in on hover, for bordered cards.
     Lives on ::before with a mask so only the 1px edge is painted and the
     card's own content shows through untouched. */
  .grad-edge {
    position: relative;
  }
  .grad-edge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--grad-gemini);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .grad-edge:hover::before {
    opacity: 1;
  }
  .grad-edge:hover {
    box-shadow: 0 0 34px -14px rgba(155, 114, 203, 0.85);
  }

  /* Gradient left-rail for the experience entries — the flat slate border
     becomes a vertical spectrum bar that intensifies on hover. */
  .grad-bar {
    position: relative;
    border-left-color: transparent;
  }
  .grad-bar::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--g1), var(--g2), var(--g3), var(--g4));
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }
  .grad-bar:hover::before {
    opacity: 1;
  }

  /* Small gradient dot that replaces the near-invisible slate "–" marker
     on every achievement bullet. */
  .bullet-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 7px;
    border-radius: 9999px;
    background: var(--grad-gemini);
  }

  /* Hairline gradient rule along the top of the footer, echoing the
     card edges. */
  .grad-top {
    position: relative;
  }
  .grad-top::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--grad-gemini);
    opacity: 0.5;
  }

  /* "lets talk!" CTA — the loudest expression of the palette: a gradient
     border whose colors flow around the pill, a light sweep that travels
     across it, and a coloured halo that breathes underneath. Every effect
     is on a pseudo-element / box-shadow so the label text is never tinted.
     Durations are deliberately slow so it feels ambient, not busy. */
  .shiny-cta {
    position: relative;
    isolation: isolate;
