---
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import { experiences, skills, links } from '../data/content';
---

<Base>
  <Stars />

  <!-- Hero -->
  <section class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <p id="hero-eyebrow" class="mono text-xs uppercase tracking-[0.3em] text-blue-400 mb-6 animate-fade-up-delay-1">
      Senior Frontend Engineer
    </p>

    <div id="hero-headline">
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-2 animate-fade-up-delay-2">
        <span class="bg-gradient-to-r from-white via-slate-200 to-slate-300 bg-clip-text text-transparent">
          Phaneendra
        </span>
      </h1>
      <h1 class="text-6xl md:text-8xl font-black leading-none tracking-tight mb-10 animate-fade-up-delay-2">
        <span class="bg-gradient-to-br from-blue-400 via-violet-400 to-violet-600 bg-clip-text text-transparent">
          Kanduri
        </span>
      </h1>
    </div>

    <script is:inline>
      // Cold-email personalization + Calendly prompt, driven entirely by
      // ?utm_medium=email&fn=&co=&e= on incoming Apollo links.
      // Self-contained on purpose (Task spec: single script, easy to remove).
      (function () {
        var params = new URLSearchParams(window.location.search);
        var utmMedium = params.get('utm_medium');
        var fn = (params.get('fn') || '').trim();
        var co = (params.get('co') || '').trim();
        var email = (params.get('e') || '').trim();

        var calendlyLoading = false;
        function openCalendlyPopup() {
          if (window.Calendly) {
            window.Calendly.initPopupWidget({
              url: 'https://calendly.com/phaneendra-9thquadrant/30min?utm_source=coldemail',
              prefill: { email: email, name: fn || '' },
            });
            return;
          }
          if (calendlyLoading) return;
          calendlyLoading = true;

          var css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://assets.calendly.com/assets/external/widget.css';
          document.head.appendChild(css);

          var script = document.createElement('script');
          script.src = 'https://assets.calendly.com/assets/external/widget.js';
          script.async = true;
          script.onload = function () {
            if (window.Calendly) {
              window.Calendly.initPopupWidget({
                url: 'https://calendly.com/phaneendra-9thquadrant/30min?utm_source=coldemail',
                prefill: { email: email, name: fn || '' },
              });
            }
          };
          document.head.appendChild(script);
        }

        // --- persistent manual CTA: works for any visitor, any time,
        // independent of the once-per-session auto-popup below.
        // Delegated on document since #book-call-btn is parsed after this
        // script runs — a direct getElementById here would find nothing.
        document.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('#book-call-btn')) {
            openCalendlyPopup();
          }
        });

        if (utmMedium !== 'email') return;

        // --- eyebrow label: swap "Senior Frontend Engineer" for the company ---
        if (co) {
          var eyebrow = document.getElementById('hero-eyebrow');
          if (eyebrow) eyebrow.textContent = co;
        }

        // --- Task 2: personalize the hero headline ---
        var text = null;
        if (fn) {
          text = 'Hi ' + fn + '. Got 15 minutes?';
        }

        if (text) {
          var headline = document.getElementById('hero-headline');
          if (headline) {
            headline.innerHTML = '';
            var h1 = document.createElement('h1');
            h1.className =
              'text-4xl md:text-6xl font-black leading-tight tracking-tight mb-10 animate-fade-up-delay-2';
            var span = document.createElement('span');
            span.className =
              'bg-gradient-to-r from-white via-slate-200 to-slate-300 bg-clip-text text-transparent';
            span.textContent = text;
            h1.appendChild(span);
            headline.appendChild(h1);

            // The headline no longer says who this site belongs to once it
            // greets the visitor by name — reintroduce it as a small line,
            // with my name weighted so it doesn't disappear into the rest.
            var intro = document.createElement('p');
            intro.className = 'text-sm text-slate-400 mb-4 animate-fade-up-delay-3';
            intro.innerHTML =
              "I'm <span class=\"font-semibold text-slate-200\">Phaneendra Kanduri</span>, frontend engineer at Confluent (an IBM company).";
            headline.insertAdjacentElement('afterend', intro);
          }
        }

        // --- Task 4: gated, delayed, prefilled Calendly popup ---
        if (!email) return;
        if (sessionStorage.getItem('coldEmailCalendlyShown')) return;

        setTimeout(function () {
          if (sessionStorage.getItem('coldEmailCalendlyShown')) return;
          sessionStorage.setItem('coldEmailCalendlyShown', '1');
          openCalendlyPopup();
        }, 1200);
      })();
    </script>

    <p class="text-base md:text-lg text-slate-400 max-w-lg mx-auto mb-4 leading-relaxed animate-fade-up-delay-3">
      9+ years turning slow, legacy frontends into fast, accessible products
      for regulated industries and Fortune 500 teams.
    </p>

    <p class="mono text-xs text-slate-200 mb-10 animate-fade-up-delay-3">
      2s → 0.2s FCP &nbsp;·&nbsp; 20min → 1.5min builds &nbsp;·&nbsp; 30s → 5s load
    </p>

 <p class="mono text-xs text-slate-200 mb-10 animate-fade-up-delay-3">
      Enterprise SaaS &nbsp;·&nbsp; Healthcare &nbsp;·&nbsp; HR Tech
    </p>

    <button
      id="book-call-btn"
      type="button"
      class="mono text-xs uppercase tracking-widest px-6 py-3 mb-8 rounded-full border border-blue-500/50 text-blue-300 hover:bg-blue-500/10 hover:border-blue-400 hover:text-blue-200 transition-colors animate-fade-up-delay-4"
    >
      Book a call
    </button>

    <div class="flex justify-center gap-4 animate-fade-up-delay-4">
      <a href="https://github.com/9thQuadrant" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
        class="icon-link">
        <!-- GitHub icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/phaneendracharyulu" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
        class="icon-link">
        <!-- LinkedIn icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="mailto:phaneendra9q@gmail.com" aria-label="Email"
        class="icon-link">
        <!-- Mail icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
      <a href="https://dev.to/9thquadrant" target="_blank" rel="noopener noreferrer" aria-label="Dev.to"
        class="icon-link">
        <!-- Dev.to icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.03 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.28-.29v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.62v1.3zm4.68 5.45c-.17.43-.64.79-1.02.79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.65 6.32-1.77 6.62z"/>
        </svg>
      </a>
    </div>

    <div class="absolute bottom-10 left-1/2 animate-bob" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        class="text-slate-600" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
      </svg>
    </div>
  </section>

  <!-- Experience -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="mono text-xs uppercase tracking-[0.3em] text-blue-400 mb-14">Experience</p>
      <div class="space-y-14">
        {experiences.map((exp) => (
          <div class="group border-l border-slate-800 pl-6 hover:border-blue-500 transition-colors duration-300">
            <div class="flex flex-wrap justify-between items-start gap-3 mb-4">
              <div>
                <h3 class="text-xl font-bold text-white">{exp.company}</h3>
                <p class="text-blue-400 text-sm mt-0.5">{exp.role}</p>
              </div>
              <div class="text-right">
                <p class="mono text-xs text-slate-500">{exp.period}</p>
                <p class="mono text-xs text-slate-600">{exp.location}</p>
              </div>
            </div>
            <ul class="space-y-2.5">
              {exp.achievements.map((a) => (
                <li class="text-slate-400 text-sm leading-relaxed flex gap-3">
                  <span class="text-slate-700 mt-1.5 shrink-0">–</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="mono text-xs uppercase tracking-[0.3em] text-blue-400 mb-14">Skills</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {skills.map((group) => (
          <div class="border border-slate-800 rounded-lg p-5 hover:border-slate-600 transition-colors duration-200">
            <p class="mono text-xs uppercase tracking-widest text-slate-600 mb-3">{group.title}</p>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="text-sm text-slate-300">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Links -->
  <section class="relative z-10 py-24 px-6">
    <div class="max-w-2xl mx-auto">
      <p class="mono text-xs uppercase tracking-[0.3em] text-blue-400 mb-14">Around the web</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map((link) => (
          <a href={link.href} target={link.href !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="flex items-center justify-between border border-slate-800 rounded-lg px-5 py-4 hover:border-blue-500 group transition-all duration-200">
            <div>
              <p class="text-sm font-medium text-white group-hover:text-blue-400 transition-colors">{link.label}</p>
              <p class="mono text-xs text-slate-600 mt-0.5">{link.sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              class="text-slate-700 group-hover:text-blue-400 transition-colors"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative z-10 py-10 px-6 text-center border-t border-slate-900">
    <a href="mailto:phaneendra@9thquadrant.com"
      class="mono text-xs text-slate-600 hover:text-blue-400 transition-colors">
      phaneendra@9thquadrant.com
    </a>
  </footer>
</Base>

<style>
  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(51 65 85); /* slate-700 */
    color: rgb(148 163 184); /* slate-400 */
    transition: border-color 0.2s, color 0.2s;
  }

  .icon-link:hover {
    border-color: rgb(96 165 250); /* blue-400 */
    color: rgb(96 165 250);
  }
</style>
