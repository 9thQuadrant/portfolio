---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Phaneendra Kanduri – Senior Frontend Engineer",
  description = "Senior Frontend Engineer with 9+ years. Specialist in performance engineering, legacy modernization, and accessibility compliance.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin.woff2"
      crossorigin
    />
    <script is:inline>
      // Flag a cold-email visit on <html> before first paint so the hero
      // renders the personalized headline directly instead of swapping it
      // in after paint. Pairs with the .is-cold-email rule in the global
      // stylesheet and the rewrite in src/pages/index.astro.
      (function () {
        try {
          var p = new URLSearchParams(window.location.search);
          if (p.get('utm_medium') === 'email' && (p.get('fn') || '').trim()) {
            document.documentElement.classList.add('is-cold-email');
          }
        } catch (e) {}
      })();
    </script>
  </head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PR1ZE2VWBN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // Strip cold-email lead params (fn/co/e) before anything reaches GA4.
  // Only utm_source/utm_medium/utm_campaign are allowed through, on both
  // page_path and page_location (gtag auto-collects page_location from the
  // raw URL otherwise, which would leak the same PII).
  (function () {
    var allowed = ['utm_source', 'utm_medium', 'utm_campaign'];
    var src = new URLSearchParams(window.location.search);
    var clean = new URLSearchParams();
    allowed.forEach(function (key) {
      var val = src.get(key);
      if (val) clean.set(key, val);
    });
    var qs = clean.toString();
    var page_path = window.location.pathname + (qs ? '?' + qs : '');
    var page_location = window.location.origin + page_path;

    gtag('config', 'G-PR1ZE2VWBN', {
      page_path: page_path,
      page_location: page_location,
    });
  })();
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xfc51gjzby");
</script>
<script>function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");
o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,
o.onload=function(){window.trackingFunctions.onLoad({appId:"696a6677ac0bae0019f52f1f"})},
document.head.appendChild(o)}initApollo();</script>

  <body class="bg-[#070a0f] text-white antialiased">
    <slot />
  </body>
</html>

<style is:global>
  /* Self-hosted, Latin-subset variable fonts (Inter + JetBrains Mono, both
     SIL OFL). Served from our own origin so rendering never depends on
     fonts.googleapis.com / fonts.gstatic.com being reachable — a proxy or
     privacy filter mangling those was dropping every digit to a .notdef
     tofu box. One file per family covers all weights via the wght axis. */
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  h1, h2, h3 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  code, .mono {
    font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.3); }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) translateX(-50%); }
    50%       { transform: translateY(6px) translateX(-50%); }
  }

  .animate-fade-up {
    animation: fade-up 0.7s ease-out forwards;
  }

  .animate-fade-up-delay-1 { animation: fade-up 0.7s 0.1s ease-out both; }
  .animate-fade-up-delay-2 { animation: fade-up 0.7s 0.2s ease-out both; }
  .animate-fade-up-delay-3 { animation: fade-up 0.7s 0.35s ease-out both; }
  .animate-fade-up-delay-4 { animation: fade-up 0.7s 0.5s ease-out both; }

  /* Cold-email visits: keep the hero hidden until index.astro has written
     the personalized headline, so visitors never see the default copy
     paint and get replaced. JS reveals it immediately (with a failsafe
     timer). visibility keeps the layout box, so there's no layout shift. */
  .is-cold-email #hero-eyebrow,
  .is-cold-email #hero-headline {
    visibility: hidden;
  }

  .animate-bob {
    animation: bob 2s ease-in-out infinite;
  }
</style>
