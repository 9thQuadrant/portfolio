<!-- Cloudflare Web Analytics -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9d301b24895a4416b001c628e9f3fbad"}'></script>
<!-- End Cloudflare Web Analytics -->

  <body class="antialiased">
    <!-- Sticky primary nav: brand (→ #top) on the left, section jump-links
         centered, theme toggle on the right. This is the main fix for
         visitors who land, look around, and never scroll — it gives them
         somewhere to click immediately instead of relying on the hero's
         scroll cue. A 3-column grid keeps the links truly centered
         regardless of how wide the brand/toggle columns are. -->
    <nav id="site-nav" aria-label="Primary">
      <a href="#top" class="site-nav__brand" aria-label="Phaneendra Kanduri — back to top">PK</a>
      <div class="site-nav__center">
        <div class="site-nav__links">
          <a href="#top">Intro</a>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#writing">Writing</a>
          <a href="#contact">Contact</a>
          <!-- single shared indicator — the nav script below slides and
               resizes this to sit under whichever link is active/hovered,
               rather than each link owning its own underline -->
          <span class="site-nav__indicator" aria-hidden="true"></span>
        </div>
      </div>
      <div class="site-nav__right">
        <button id="theme-toggle" type="button" aria-label="Switch to light theme">
          <!-- shown in dark mode: tap for light -->
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <!-- shown in light mode: tap for dark -->
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </nav>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function label() {
          return document.documentElement.getAttribute('data-theme') === 'light'
            ? 'Switch to dark theme'
            : 'Switch to light theme';
        }
        btn.setAttribute('aria-label', label());
        btn.addEventListener('click', function () {
          var next =
            document.documentElement.getAttribute('data-theme') === 'light'
              ? 'dark'
              : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          btn.setAttribute('aria-label', label());
          // let the canvas dot-field recolour itself
          window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
        });
      })();
    </script>
    <slot />
    <script is:inline>
      // Nav scroll-spy + sliding indicator. Runs after <slot/> so the
      // section elements it looks up (#experience etc.) already exist.
      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('.site-nav__links a'));
        var indicator = document.querySelector('.site-nav__indicator');
        var container = document.querySelector('.site-nav__links');
        if (!links.length || !indicator || !container) return;

        // only show the "more to scroll" fade when the links genuinely
        // don't fit — otherwise it was permanently eating into the last
        // link (Contact) even when there was nothing to scroll to
        function checkOverflow() {
          container.classList.toggle('has-overflow', container.scrollWidth > container.clientWidth + 1);
        }
        checkOverflow();
        window.addEventListener('resize', checkOverflow, { passive: true });

        var sections = links
          .map(function (a) {
            var id = (a.getAttribute('href') || '').replace('#', '');
            return { link: a, el: id ? document.getElementById(id) : null };
          })
          .filter(function (s) { return s.el; });

        var current = null; // the link the indicator should rest on

        function moveIndicatorTo(link) {
          if (!link) {
            indicator.style.opacity = '0';
            return;
          }
          var lr = link.getBoundingClientRect();
          var cr = container.getBoundingClientRect();
          indicator.style.width = lr.width + 'px';
          indicator.style.transform = 'translateX(' + (lr.left - cr.left + container.scrollLeft) + 'px)';
          indicator.style.opacity = '1';
        }

        function setActive(link) {
          current = link;
          links.forEach(function (a) { a.classList.toggle('is-active', a === link); });
          moveIndicatorTo(link);
        }

        // "Intro" (→ #top) is highlighted by default on load, before the
        // visitor has scrolled anywhere; scrolling into a later section
        // hands the highlight off via the observer below, and scrolling
        // back up to the hero hands it back (#top is itself observed).
        var introLink = links.find(function (a) { return a.getAttribute('href') === '#top'; });
        if (introLink) setActive(introLink);

        // scroll-spy: highlight whichever section is under the reading
        // band just below the fixed nav
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var match = sections.find(function (s) { return s.el === entry.target; });
                if (match) setActive(match.link);
              });
            },
            { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
          );
          sections.forEach(function (s) { io.observe(s.el); });
        }

        // hover shows a preview of that link's position; leaving reverts
        // to whatever section is actually active from scrolling
        links.forEach(function (a) {
          a.addEventListener('mouseenter', function () { moveIndicatorTo(a); });
          a.addEventListener('mouseleave', function () { moveIndicatorTo(current); });
          a.addEventListener('focus', function () { moveIndicatorTo(a); });
          a.addEventListener('blur', function () { moveIndicatorTo(current); });
        });

        window.addEventListener('resize', function () { moveIndicatorTo(current); }, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Self-hosted, Latin-subset fonts (Source Sans 3 + JetBrains Mono, both
     SIL OFL). Served from our own origin so rendering never depends on
     fonts.googleapis.com / fonts.gstatic.com being reachable — a proxy or
     privacy filter mangling those was dropping every digit to a .notdef
     tofu box. Source Sans 3 is a humanist sans: warmer and easier on the
     eye than a neutral grotesque, which suits the audience (hiring
     managers, engineering leaders). JetBrains Mono is kept for the metrics
     line only. One variable file per family covers every weight. */
  @font-face {
    font-family: 'Source Sans 3';
    font-style: normal;
    font-weight: 200 900;
    font-display: swap;
    src: url('/fonts/source-sans-3-latin.woff2') format('woff2');
  }

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
  }

  /* Italic-only — used exclusively for the hero's rotating quote line, so
     no upright cut is loaded. Medium is DM Mono's heaviest cut; the
     rotator asks for a bold weight and the browser maps it to this face. */
  @font-face {
    font-family: 'DM Mono';
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/dm-mono-medium-italic-latin.woff2') format('woff2');
  }

  /* ---------------------------------------------------------------------
     Semantic colour tokens. Dark is the default; [data-theme="light"]
     re-points the same names. Every component reads these, never a raw
     hex, so the toggle is a single attribute flip. Contrast is tuned up
     from the old palette — body copy now lands well inside WCAG AA. */
  :root,
  :root[data-theme='dark'] {
    --bg: #070a0f;
    --surface: rgba(226, 236, 255, 0.07); /* cool fill so cards read as cards, not gaps */
    --surface-hover: rgba(226, 236, 255, 0.11);
    --border: #33415580; /* slate-700 @ 50% */
    --border-solid: #3a4a63;

    --heading: #f8fafc;
    --text: #e7ecf3; /* primary body */
    --text-secondary: #c7d0de;
    --text-muted: #9aa7bb; /* meta / labels */
    --text-faint: #77869c;

    --label: #9cc0ff; /* section eyebrows — bright, clearly visible */
    --link: #74a8ff;

    --shine-1: #5b9bff;
    --shine-2: #b98cf0;
    --shine-3: #ef7d88;
    --shine-4: #ffc078;

    --aurora-blend: screen;
    --aurora-opacity: 0.55;
    --aurora-saturate: 1.3;
    --aurora-1: #34d399; /* green  */
    --aurora-2: #22d3ee; /* cyan   */
    --aurora-3: #a78bfa; /* violet */
    --aurora-4: #f472b6; /* pink   */

    --dot-rgb: 169, 181, 198; /* slate-400, lightened 20% toward white */
    --shadow-ink: rgba(2, 4, 9, 0.92);
    --card-shadow: none;
    --cue-glow: rgba(116, 168, 255, 0.5);
    --nav-bg: rgba(7, 10, 15, 0.72);
  }

  :root[data-theme='light'] {
    --bg: #f6f5f2; /* warm off-white — softer than stark white for older eyes */
    --surface: #ffffff; /* clean white cards lift off the warm ground */
    --surface-hover: #fbfaf7;
    --border: #e2ddd2;
    --border-solid: #d9d3c6;

    --heading: #16202e;
    --text: #2b3545; /* ~11:1 on --bg */
    --text-secondary: #3f4a5c;
    --text-muted: #59626f;
    --text-faint: #78808d;

    --label: #4338ca; /* indigo — strong on the light ground */
    --link: #2563eb;

    --shine-1: #2563eb;
    --shine-2: #7c3aed;
    --shine-3: #db2777;
    --shine-4: #d97706;

    --aurora-blend: multiply;
    /* light mode carries most of the traffic (per Clarity) and multiply
       can only ever darken toward the page colour, so it needs real
       opacity + extra saturation to read as vibrant rather than washed out */
    --aurora-opacity: 0.34;
    --aurora-saturate: 1.75;
    --aurora-1: #059669;
    --aurora-2: #0891b2;
    --aurora-3: #7c3aed;
    --aurora-4: #db2777;

    --dot-rgb: 57, 68, 84; /* slate-600, darkened 20% */
    --shadow-ink: rgba(246, 245, 242, 0.85);
    --card-shadow: 0 1px 2px rgba(20, 25, 40, 0.04), 0 4px 14px -6px rgba(20, 25, 40, 0.1);
    --cue-glow: rgba(37, 99, 235, 0.28);
    --nav-bg: rgba(246, 245, 242, 0.78);
  }

  /* gradient accent reused site-wide (label bars, card edges, bullet dots,
     icon rings, CTA border) — tracks the theme via the shine tokens */
  :root {
    --g1: var(--shine-1);
    --g2: var(--shine-2);
    --g3: var(--shine-3);
    --g4: var(--shine-4);
    --grad-gemini: linear-gradient(115deg, var(--g1), var(--g2), var(--g3), var(--g4));
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    /* keeps anchor-scrolled sections from landing underneath the fixed nav */
    scroll-padding-top: 76px;
  }

  body {
    font-family: 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background-color 0.35s ease, color 0.35s ease;
  }

  h1, h2, h3 {
    font-family: 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  code, .mono {
    font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
  }

  /* ---- sticky primary nav ---- */
  /* 3-column grid — not flex+space-between — so the middle column (the
     links) sits genuinely centered on the bar regardless of how wide the
     brand and toggle columns are, rather than centered-within-the-leftover
     space after those two. */
  #site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0 1.25rem;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  /* Initials, not the full name — sized well above the nav links. The
     glyphs are hollow (transparent fill): only the outline is drawn, via
     -webkit-text-stroke, and it's the outline colour that animates —
     cycling through the same four hues "Kanduri" uses in the hero
     (--g1..--g4) — while the letterforms themselves stay put. That keeps
     the motion on the border only, not the whole text. */
  .site-nav__brand {
    justify-self: start;
    font-size: 2.25rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke-width: 1.75px;
    -webkit-text-stroke-color: var(--g1);
    animation: brand-border 5s linear infinite;
    transition: filter 0.2s ease;
  }
  .site-nav__brand:hover {
    filter: brightness(1.3);
  }
  @keyframes brand-border {
    0%   { -webkit-text-stroke-color: var(--g1); }
    25%  { -webkit-text-stroke-color: var(--g2); }
    50%  { -webkit-text-stroke-color: var(--g3); }
    75%  { -webkit-text-stroke-color: var(--g4); }
    100% { -webkit-text-stroke-color: var(--g1); }
  }
  /* graceful fallback for the rare browser without text-stroke support —
     solid, legible, unanimated, rather than invisible transparent text */
  @supports not (-webkit-text-stroke: 1px black) {
    .site-nav__brand {
      color: var(--heading);
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__brand {
      animation: none;
      -webkit-text-stroke-color: var(--g2);
    }
  }

  /* centre grid column — its own min-width:0 so it can shrink below the
     links' natural content width instead of pushing the grid wider */
  .site-nav__center {
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .site-nav__right {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .site-nav__links {
    position: relative; /* anchors .site-nav__indicator */
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    /* room below the labels for the sliding underline */
    padding-bottom: 0.65rem;
    margin-bottom: -0.65rem;
    min-width: 0;
  }
  .site-nav__links::-webkit-scrollbar {
    display: none;
  }
  /* Fade hint that there's more to scroll — only added by the nav script
     once it measures actual overflow, so it never eats into "Contact" (or
     any last link) on widths where everything already fits. */
  .site-nav__links.has-overflow {
    -webkit-mask-image: linear-gradient(to right, #000 88%, transparent 100%);
            mask-image: linear-gradient(to right, #000 88%, transparent 100%);
  }
  @media (max-width: 480px) {
    .site-nav__links {
      gap: 1rem;
    }
    .site-nav__links a {
      font-size: 0.75rem;
    }
  }
  .site-nav__links a {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .site-nav__links a:hover,
  .site-nav__links a:focus-visible,
  .site-nav__links a.is-active {
    color: var(--heading);
  }

  /* the one shared underline: the nav script (after <slot/>) sets its
     width + translateX to match whichever link is active/hovered, so it
     slides and resizes between positions instead of each link carrying
     its own static underline. */
  .site-nav__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    border-radius: 2px;
    background: var(--grad-gemini);
    opacity: 0;
    transform: translateX(0);
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1),
      width 0.35s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.25s ease;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__indicator {
      transition: opacity 0.25s ease;
    }
  }

  /* ---- theme toggle (lives inside the nav) ---- */
  #theme-toggle {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border-solid);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  #theme-toggle:hover {
    color: var(--heading);
    border-color: var(--text-faint);
  }
  #theme-toggle .icon-moon { display: none; }
  :root[data-theme='light'] #theme-toggle .icon-sun { display: none; }
  :root[data-theme='light'] #theme-toggle .icon-moon { display: block; }

  /* visually hidden but present for screen readers — used to give the
     rotating hero line an accessible, one-time announcement instead of
     wrapping the rotator itself in aria-live (which would re-announce it
     every 3.5s) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .animate-fade-up {
    animation: fade-up 0.7s ease-out forwards;
  }

  .animate-fade-up-delay-1 { animation: fade-up 0.7s 0.1s ease-out both; }
  .animate-fade-up-delay-2 { animation: fade-up 0.7s 0.2s ease-out both; }
  .animate-fade-up-delay-3 { animation: fade-up 0.7s 0.35s ease-out both; }
  .animate-fade-up-delay-4 { animation: fade-up 0.7s 0.5s ease-out both; }

  /* Cold-email visits: keep the hero hidden until index.astro has written
     the personalized headline, so visitors never see the default copy
     paint and get replaced. JS reveals it immediately (with a failsafe
     timer). visibility keeps the layout box, so there's no layout shift. */
  .is-cold-email #hero-eyebrow,
  .is-cold-email #hero-headline {
    visibility: hidden;
  }
</style>
