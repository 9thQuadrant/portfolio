---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Phaneendra Kanduri – Senior Frontend Engineer",
  description = "Senior Frontend Engineer with 9+ years. Specialist in performance engineering, legacy modernization, and accessibility compliance.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-sans-3-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin.woff2"
      crossorigin
    />
    <script is:inline>
      // Resolve the colour theme before first paint (no flash). Stored
      // choice wins; otherwise follow the OS setting. Pairs with the
      // [data-theme] token blocks in the global stylesheet and the toggle
      // button wired up further down.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();

      // Flag a cold-email visit on <html> before first paint so the hero
      // renders the personalized headline directly instead of swapping it
      // in after paint. Pairs with the .is-cold-email rule in the global
      // stylesheet and the rewrite in src/pages/index.astro.
      (function () {
        try {
          var p = new URLSearchParams(window.location.search);
          if (p.get('utm_medium') === 'email' && (p.get('fn') || '').trim()) {
            document.documentElement.classList.add('is-cold-email');
          }
        } catch (e) {}
      })();
    </script>
  </head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PR1ZE2VWBN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // Strip cold-email lead params (fn/co/e) before anything reaches GA4.
  // Only utm_source/utm_medium/utm_campaign are allowed through, on both
  // page_path and page_location (gtag auto-collects page_location from the
  // raw URL otherwise, which would leak the same PII).
  (function () {
    var allowed = ['utm_source', 'utm_medium', 'utm_campaign'];
    var src = new URLSearchParams(window.location.search);
    var clean = new URLSearchParams();
    allowed.forEach(function (key) {
      var val = src.get(key);
      if (val) clean.set(key, val);
    });
    var qs = clean.toString();
    var page_path = window.location.pathname + (qs ? '?' + qs : '');
    var page_location = window.location.origin + page_path;

    gtag('config', 'G-PR1ZE2VWBN', {
      page_path: page_path,
      page_location: page_location,
    });
  })();
